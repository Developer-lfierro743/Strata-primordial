<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#1a1a2e"
    android:padding="24dp">

    <!-- Game Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="STRATA: PRIMORDIAL"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#e94560"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Minecraft 2 — The Voxel Revolution"
        android:textSize="14sp"
        android:textColor="#a0a0a0"
        android:layout_marginBottom="48dp" />

    <!-- Play Button -->
    <Button
        android:id="@+id/playButton"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:text="▶ PLAY"
        android:textSize="18sp"
        android:textColor="#ffffff"
        android:backgroundTint="#e94560"
        android:layout_marginBottom="16dp" />

    <!-- Settings Button -->
    <Button
        android:id="@+id/settingsButton"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:text="⚙ SETTINGS"
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:backgroundTint="#16213e"
        android:layout_marginBottom="16dp" />

    <!-- Mods Button -->
    <Button
        android:id="@+id/modsButton"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:text="🧩 MODS"
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:backgroundTint="#16213e"
        android:layout_marginBottom="16dp" />

    <!-- Quit Button -->
    <Button
        android:id="@+id/quitButton"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:text="✕ QUIT"
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:backgroundTint="#0f3460"
        android:layout_marginBottom="32dp" />

    <!-- Version -->
    <TextView
        android:id="@+id/versionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v0.1.0-alpha | Kotlin/Native + Vulkan"
        android:textSize="10sp"
        android:textColor="#606060" />

</LinearLayout>
